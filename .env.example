# Google Cloud OAuth Client ID (for Google Sign-In and Google Sheets OAuth)
NUXT_PUBLIC_GOOGLE_CLIENT_ID=

# --------------------------------------------------------------------------
# Cloudinary Configuration
# --------------------------------------------------------------------------
# Option A (Recommended for client-side direct uploads):
# Create an "Unsigned" preset in Cloudinary Console:
# Cloudinary Console -> Settings -> Upload -> Upload presets -> Signing Mode: "Unsigned"
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=apper_files
NUXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=apper_files

# Option B (Server-side signed uploads via Nuxt Nitro /api/upload):
# If you prefer to keep your preset "Signed", supply API credentials below:
CLOUDINARY_CLOUD_NAME=apper_files
CLOUDINARY_API_KEY=261116216519738
CLOUDINARY_API_SECRET=c-7ulLnQAybto9T1CVcqSXm8Ydg
